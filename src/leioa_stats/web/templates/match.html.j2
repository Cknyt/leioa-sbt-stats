{% extends "base.html.j2" %}
{% from "macros.html.j2" import fold, how %}
{% block title %}J{{ match.round }} · {{ title }}{% endblock %}
{% block content %}
<p class="back"><a href="{{ root }}partidos.html">← Partidos</a></p>
<section class="hero">
  <p class="meta">Jornada {{ match.round }} · {{ date }}</p>
  <h1>{{ title }}</h1>
  <div class="table-wrap">{{ quarters | safe }}</div>
  <p class="meta">{{ possessions }} posesiones · ritmo {{ pace }} por 40 minutos</p>
</section>

{% if keys %}
<section class="insights" id="claves">
  <h2>Claves del partido</h2>
  <ul class="insight-list">
    {% for item in keys %}<li>{{ item }}</li>{% endfor %}
  </ul>
</section>
{% endif %}

{% call fold("marcador", "Evolución del marcador", open=True) %}
  <p class="hint">Por encima de 0 gana {{ team_name }}; por debajo, {{ rival }}. Las líneas de puntos separan los cuartos.</p>
  <div class="chart">{{ timeline | safe }}</div>
{% endcall %}

{% call fold("box", team_name, open=True) %}
  <div class="table-wrap">{{ box | safe }}</div>
  <p class="hint">MIN según el acta. +/- según el jugada a jugada.</p>
{% endcall %}

{% call fold("factores", "Eficiencia y Four Factors") %}
  <div class="table-wrap">{{ factors | safe }}</div>
{% endcall %}

{% if review %}
{% call fold("revision", "La previa frente a lo que pasó") %}
  {% if review.checked %}<p><b>{{ review.hits }} de {{ review.checked }}</b> veredictos se cumplieron.</p>{% endif %}
  {{ how("Cruces calculados solo con las " ~ review.rounds ~ " jornadas anteriores a este partido, como se habrían visto en la previa. \"Esperable\" = valor del atacante + lo que permite el defensor − media de la liga. \"¿Se cumplió?\" solo se responde en los cruces con veredicto: si el valor real quedó del lado previsto respecto a la media de la liga.") }}
  <div class="table-wrap">{{ review.table | safe }}</div>
{% endcall %}
{% endif %}

{% call fold("tiros", "Mapa de tiros · " ~ team_name) %}
  <div class="chart">{{ shots | safe }}</div>
  <div class="table-wrap">{{ zones | safe }}</div>
{% endcall %}

{% call fold("quintetos", "Quintetos") %}
  <div class="table-wrap">{{ lineups | safe }}</div>
  <p class="legend">{% for n, p in legend %}<span><b>{{ n }}</b> {{ p }}</span>{% endfor %}</p>
{% endcall %}

{% call fold("rival", rival) %}
  <div class="table-wrap">{{ box_rival | safe }}</div>
  <h3>Mapa de tiros · {{ rival }}</h3>
  <div class="chart">{{ shots_rival | safe }}</div>
{% endcall %}

{% if issues %}
{% call fold("fiabilidad", "Fiabilidad de los datos", extra_class="issues") %}
  <p class="hint">Posibles errores de anotación en la mesa, detectados al cruzar el jugada a jugada con el acta:</p>
  <ul>
  {% for i in issues %}<li><b>{{ i.check }}</b>{% if i.team %} ({{ i.team | title }}){% endif %}: {{ i.detail }}</li>{% endfor %}
  </ul>
{% endcall %}
{% endif %}

{% include "glossary.html.j2" %}
{% endblock %}

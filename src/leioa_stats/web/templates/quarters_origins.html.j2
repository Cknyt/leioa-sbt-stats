{# Por cuartos y origen de los puntos: en la temporada del equipo y en cada informe de scouting. #}
{% from "macros.html.j2" import fold, how %}
{% call fold("cuartos", "Por cuartos") %}
  <p class="hint">Medias por partido de cada cuarto (PR = prórrogas). "Rival" y "Forzadas" son lo que hicieron sus rivales.</p>
  <div class="table-wrap">{{ quarters | safe }}</div>
{% endcall %}

{% call fold("origen", "Origen de los puntos") %}
  {{ how('Estimación a partir del jugada a jugada, siguiendo quién tiene el balón. "Rivales" es lo que le anotan a ' ~ subject ~ '. Un punto puede contar a la vez como "tras pérdida" y "contraataque", así que no se suman entre sí.') }}
  <div class="table-wrap">{{ origins | safe }}</div>
{% endcall %}

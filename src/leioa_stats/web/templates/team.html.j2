{% extends "base.html.j2" %}
{% block title %}{{ name }}{% endblock %}
{% block content %}
<p class="back"><a href="{{ root }}index.html">← Temporada</a> · <a href="{{ root }}index.html#liga">Liga</a></p>
<section class="hero">
  <p class="meta">{{ 'Nuestro equipo' if is_own else 'Scouting' }} · {{ results | length }} partidos</p>
  <h1>{{ name }}</h1>
  <p class="record">Balance <strong>{{ record }}</strong></p>
  <div class="ranks">
    <span data-term="Ritmo">Ritmo <b>{{ ranks.RITMO }}º</b></span>
    <span data-term="Ataque">Ataque <b>{{ ranks.ORtg }}º</b></span>
    <span data-term="Defensa">Defensa <b>{{ ranks.DRtg }}º</b></span>
    <span data-term="Neto">Neto <b>{{ ranks.NETO }}º</b></span>
    <span data-term="Tiro (eFG%)">Tiro (eFG%) <b>{{ ranks['eFG%'] }}º</b></span>
    <span data-term="Pérdidas">Pérdidas <b>{{ ranks['PER%'] }}º</b></span>
    <span data-term="Rebote of.">Rebote of. <b>{{ ranks['RO%'] }}º</b></span>
    <span data-term="Tiros libres">Tiros libres <b>{{ ranks['TL/TC'] }}º</b></span>
  </div>
  <p class="hint">Puesto entre los {{ n_teams }} equipos de la liga (1º = el mejor; en ritmo, el más rápido).</p>
  {% if not is_own %}<p class="back"><a href="{{ preview_link }}">Previa del partido contra {{ team_name }} →</a> · <a href="{{ root }}comparativa.html#{{ slug }}">Comparar con {{ team_name }} →</a></p>{% endif %}
  {% if results | length < 6 %}
  <p class="note">Con {{ results | length }} partidos la muestra es pequeña: sirve para orientarse, no para sacar conclusiones firmes.</p>
  {% endif %}
</section>

{% with ideas_title = "Lo que pueden plantearnos los rivales" if is_own else "Ideas para el partido" %}
{% include "insights.html.j2" %}
{% endwith %}

<section>
  <h2>Resultados</h2>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>J</th><th>Rival</th><th></th><th>Resultado</th></tr></thead>
      <tbody>
      {% for r in results %}
        <tr>
          <td>{{ r.round }}</td>
          <td class="left">{% if r.link %}<a href="{{ r.link }}">{{ r.rival }}</a>{% else %}{{ r.rival }}{% endif %}</td>
          <td class="left">{{ r.where }}</td>
          <td><span class="badge {{ 'win' if r.won else 'loss' }}">{{ 'V' if r.won else 'D' }}</span> {{ r.score }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section>
  <h2>Dónde es fuerte</h2>
  <p class="hint">Su ataque, la media de la liga y lo que permite su defensa a los rivales.</p>
  <div class="table-wrap">{{ factors | safe }}</div>
</section>

<section id="rotacion">
  <h2>Rotación y disponibilidad</h2>
  {% if missed_last %}<p class="note">No estuvieron en su último partido: {{ missed_last | join(", ") }}. Revisa si son bajas antes de fiarte de sus medias.</p>{% endif %}
  {% if starters %}<p><b>Titulares</b> (veces): {{ starters }}.</p>{% endif %}
  {% if closers %}<p><b>Cierran los partidos</b> (tiempo en pista en los últimos 4 minutos): {{ closers }}.</p>{% endif %}
  {% if minute_map %}
  <h3>Cuándo juega cada uno</h3>
  <p class="hint">Color más intenso = en pista en ese minuto en más partidos. Las líneas de puntos separan los cuartos. Sale del jugada a jugada: es lo que ha hecho, no una estimación.</p>
  <div class="chart">{{ minute_map | safe }}</div>
  {% endif %}
  <h3>Minutos por jornada</h3>
  <p class="hint">"–" = no estaba en el acta (baja, sanción o decisión técnica: el acta no lo distingue). 0 = convocado sin jugar.</p>
  <div class="table-wrap">{{ availability | safe }}</div>
</section>

{% with subject = name %}{% include "quarters_origins.html.j2" %}{% endwith %}

<section id="balon">
  <h2>Balón, faltas y pase</h2>
  <h3>Pérdidas por partido, por tipo</h3>
  <p class="hint">"Con robo" son pérdidas a balón vivo: las que provoca la presión. "Otras": pasos, campo atrás, fuera de banda, 24 segundos... Las pérdidas "de equipo" no están en el jugada a jugada.</p>
  <div class="table-wrap">{{ turnovers | safe }}</div>
  {% if connections %}
  <h3>Conexiones de pase</h3>
  <p class="hint">Quién asiste a quién: canastas de campo y, de ellas, triples. Qué es asistencia lo decide la mesa.</p>
  <div class="table-wrap">{{ connections | safe }}</div>
  {% endif %}
  <h3>Faltas por jugador</h3>
  <p class="hint">Faltas cometidas y recibidas por 40 minutos y partidos con problemas de faltas. Solo jugadores con 30 minutos o más.</p>
  <div class="table-wrap">{{ fouls | safe }}</div>
  <h3>Minutos en bonus por cuarto</h3>
  <p class="hint">Media por partido del tiempo que queda de cada cuarto desde la 4.ª falta del equipo: a partir de ahí, cada falta da tiros libres al rival.</p>
  <div class="table-wrap">{{ bonus | safe }}</div>
</section>

<section>
  <h2>Jugadores</h2>
  <p class="hint">"Perfil" es una estimación a partir de dónde tira cada jugador y de cuántos rebotes ofensivos coge (la federación no publica posiciones).</p>
  <div class="table-wrap">{{ players | safe }}</div>
</section>

<section>
  <h2>Mapa de tiros del equipo</h2>
  <div class="chart">{{ shots | safe }}</div>
  <div class="table-wrap">{{ zones | safe }}</div>
  <h3>Lo que concede su defensa, por zonas</h3>
  <p class="hint">Tiros de sus rivales contra este equipo.</p>
  <div class="table-wrap">{{ zones_conceded | safe }}</div>
</section>

<section>
  <h2>Mapa de tiros por jugador</h2>
  <p class="hint">Los {{ player_charts | length }} jugadores que más tiran.</p>
  <div class="player-grid">
  {% for p in player_charts %}
    <div class="player-card">
      <h3>{{ p.number }} · {{ p.name }}</h3>
      <p class="meta">{{ p.summary }}</p>
      <div class="chart">{{ p.chart | safe }}</div>
      <div class="table-wrap">{{ p.zones | safe }}</div>
    </div>
  {% endfor %}
  </div>
</section>

<section>
  <h2>Quintetos más usados</h2>
  <div class="table-wrap">{{ lineups | safe }}</div>
  <p class="legend">{% for n, p in legend %}<span><b>{{ n }}</b> {{ p }}</span>{% endfor %}</p>
</section>

{% include "glossary.html.j2" %}
{% endblock %}

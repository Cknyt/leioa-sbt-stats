<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# Salen nombres de jugadores: la web se ve con el enlace, pero no aparece en buscadores. #}
  <meta name="robots" content="noindex, nofollow">
  <title>{% block title %}{{ team_name }}{% endblock %} · Estadísticas</title>
  {# Fuentes y gráficos servidos desde el propio hosting: ninguna petición a otros servidores
     (que verían la IP de quien visita la web). #}
  <link rel="stylesheet" href="{{ root }}style.css">
  {% if charts %}<script src="{{ root }}plotly.min.js" charset="utf-8"></script>{% endif %}
  <script src="{{ root }}page.js" defer></script>
  <script src="{{ root }}visits.js" data-endpoint="{{ root }}registrar.php" defer></script>
</head>
<body>
  <header class="top">
    <div class="top-inner">
      <div class="top-title">
        <a class="brand" href="{{ root }}index.html">{{ team_name }}</a>
        <span class="subtitle">1ª División Masculina · Temporada 2026-27 · Datos hasta la jornada {{ last_round }}</span>
      </div>
      <nav class="tabs" aria-label="Páginas">
        <a href="{{ root }}index.html"{% if active == "season" %} aria-current="page"{% endif %}>Resumen</a>
        {% if next_preview %}<a href="{{ root }}{{ next_preview }}"{% if active == "preview" %} aria-current="page"{% endif %}>Previa</a>{% endif %}
        <a href="{{ root }}jugadores.html"{% if active == "players" %} aria-current="page"{% endif %}>Jugadores</a>
        <a href="{{ root }}partidos.html"{% if active == "games" %} aria-current="page"{% endif %}>Partidos</a>
        <a href="{{ root }}liga.html"{% if active == "league" %} aria-current="page"{% endif %}>Liga</a>
      </nav>
    </div>
  </header>
  <main>
    {% block content %}{% endblock %}
  </main>
  <footer>
    <p><a href="#glosario">Glosario y fórmulas</a></p>
    <p>Datos públicos de <a href="https://basketbasko.com/es/group/?id=2876">basketbasko.com</a> (Federación Vasca de Baloncesto), anotados a mano en la mesa del partido. {{ n_games }} partidos. Generado el {{ generated }}.</p>
  </footer>
</body>
</html>

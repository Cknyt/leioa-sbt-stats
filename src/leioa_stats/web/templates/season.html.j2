{% extends "base.html.j2" %}
{% block title %}Temporada{% endblock %}
{% block content %}
<div class="overview">
  <section class="summary">
    <h1>Temporada</h1>
    <div class="record-big">
      <div class="tally win"><strong>{{ wins }}</strong><span>victorias</span></div>
      <span class="dash" aria-hidden="true">–</span>
      <div class="tally loss"><strong>{{ losses }}</strong><span>derrotas</span></div>
      <p class="streak" aria-label="Resultados por jornada">
        {% for g in games %}<span class="badge {{ 'win' if g.won else 'loss' }}" title="Jornada {{ g.match.round }}">{{ 'V' if g.won else 'D' }}</span>{% endfor %}
      </p>
    </div>
    {% if n_games < 8 %}
    <p class="note">Solo hay {{ n_games }} partidos: las cifras describen lo que ha pasado, pero todavía no permiten sacar conclusiones (sobre todo las de quintetos y on/off).</p>
    {% endif %}
  </section>

  {% if next_match %}
  <section class="next-card">
    <p class="eyebrow">Próximo partido · Jornada {{ next_match.round }}</p>
    <p class="next-rival">{{ next_rival }}</p>
    <p class="chips"><span class="chip">{{ next_date }}</span><span class="chip accent">{{ 'En casa' if next_home else 'Fuera' }}</span></p>
    <a class="button" href="equipos/{{ next_rival_slug }}.html">Ver el informe del rival →</a>
  </section>
  {% endif %}
</div>

<div class="kpis">
  {% for k in kpis %}
  <div class="kpi">
    <span class="kpi-label" data-term="{{ k.term }}">{{ k.term }}</span>
    <strong>{{ k.value }}</strong>
    <span class="kpi-detail">{{ k.detail }} · {{ k.rank }}º de {{ n_teams }}</span>
  </div>
  {% endfor %}
</div>
<p class="hint">Puesto entre los {{ n_teams }} equipos de la liga (1º = el mejor; en ritmo, el más rápido).</p>

<section class="plain" id="partidos">
  <h2>Partidos</h2>
  <div class="game-grid">
  {% for g in games %}
    <a class="game" href="partidos/{{ g.match.id }}.html" aria-label="Jornada {{ g.match.round }}: {{ g.title }}">
      <span class="game-meta"><span>Jornada {{ g.match.round }} · {{ g.date }}</span>{% if g.issues %}<span class="warn">{{ g.issues }} aviso{{ 's' if g.issues > 1 }} en los datos</span>{% endif %}</span>
      <span class="game-score">
        <span class="badge big {{ 'win' if g.won else 'loss' }}">{{ 'V' if g.won else 'D' }}</span>
        <span class="game-teams">
          <span class="{{ 'own' if g.own_home }}"><span>{{ g.home }}</span><b>{{ g.match.local_score }}</b></span>
          <span class="{{ 'own' if not g.own_home }}"><span>{{ g.away }}</span><b>{{ g.match.visitor_score }}</b></span>
        </span>
      </span>
      <span class="game-stats">
        <span data-term="Ritmo">Ritmo <b>{{ g.pace }}</b></span>
        <span data-term="ORtg">ORtg <b>{{ g.ortg }}</b></span>
        <span data-term="DRtg">DRtg <b>{{ g.drtg }}</b></span>
        <span data-term="Neto">Neto <b>{{ g.net }}</b></span>
      </span>
    </a>
  {% endfor %}
  </div>
</section>

{% with ideas_title = "Lo que pueden plantearnos los rivales" %}
{% include "insights.html.j2" %}
{% endwith %}

<section>
  <h2>Equipo frente a sus rivales</h2>
  <p class="hint">Medias por partido y porcentajes de tiro. "Rivales" es lo que han hecho los rivales contra {{ team_name }}.</p>
  <div class="table-wrap">{{ team | safe }}</div>
  <h3>Ritmo, eficiencia y Four Factors</h3>
  <p class="hint">En la columna de rivales: lo que permite la defensa.</p>
  <div class="table-wrap">{{ advanced | safe }}</div>
</section>

<section id="tiro">
  <h2>De dónde salen los tiros</h2>
  <p class="hint">La barra es el % de los tiros de campo que salen de cada zona; la cifra, el acierto.</p>
  <div class="zone-bars">
  {% for z in zone_bars %}
    <div class="zone-bar">
      <span class="zone-name">{{ z.zone }}</span>
      <span class="bar" role="img" aria-label="{{ z.share }} % de los tiros"><span style="width: {{ z.width }}%"></span></span>
      <span class="zone-value"><b>{{ z.pct }}{% if z.attempts %} %{% endif %}</b> <span>{{ z.attempts }} tiros · {{ z.share }} %</span></span>
    </div>
  {% endfor %}
  </div>
  <h3>Mapa de tiros</h3>
  <div class="chart">{{ shots | safe }}</div>
  <h3>Por zonas</h3>
  <div class="table-wrap">{{ zones | safe }}</div>
  <h3>Por zonas, rivales</h3>
  <div class="table-wrap">{{ zones_rivals | safe }}</div>
</section>

<section>
  <h2>+/- y on/off</h2>
  <p class="hint">Neto = diferencia de puntos por 100 posesiones. "En banquillo" es el neto del equipo mientras el jugador no está en pista. Minutos según el reloj del jugada a jugada.</p>
  <div class="table-wrap">{{ on_off | safe }}</div>
</section>

<section id="quintetos">
  <h2>Quintetos</h2>
  <p class="hint">Los 10 con más minutos, por dorsales.</p>
  <div class="table-wrap">{{ lineups | safe }}</div>
  {% if lineups_incomplete %}<p class="note">{{ lineups_incomplete }} minutos sin 5 jugadores en pista (cambio mal anotado) no cuentan.</p>{% endif %}
  <p class="legend">{% for n, p in legend %}<span><b>{{ n }}</b> {{ p }}</span>{% endfor %}</p>
</section>

<section id="liga">
  <h2>Liga</h2>
  <p class="hint">Los {{ league_rows | length }} equipos con {{ n_league_games }} partidos jugados. Pulsa en un equipo para ver su informe de scouting.</p>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Equipo</th>{% for c in league_columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for row in league_rows %}
        <tr class="{{ 'own' if row.own }}{{ ' next' if row.next }}">
          <th><a href="equipos/{{ row.slug }}.html">{{ row.name }}</a>{% if row.next %} <span class="tag">próximo rival</span>{% endif %}</th>
          {% for v in row['values'] %}<td>{{ v }}</td>{% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

{% include "glossary.html.j2" %}
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Temporada{% endblock %}
{% block content %}
<section class="hero">
  <h1>Temporada</h1>
  <p class="record"><strong>{{ wins }}</strong> victorias · <strong>{{ losses }}</strong> derrotas</p>
  {% if n_games < 8 %}
  <p class="note">Solo hay {{ n_games }} partidos: las cifras describen lo que ha pasado, pero todavía no permiten sacar conclusiones (sobre todo las de quintetos y on/off).</p>
  {% endif %}
  <p><a href="equipos/{{ own_slug }}.html">Jugadores en detalle: mapa de tiros de cada uno →</a></p>
</section>

{% if next_match %}
<section class="next">
  <h2>Próximo partido</h2>
  <p class="meta">Jornada {{ next_match.round }} · {{ next_date }} · {{ 'en casa' if next_home else 'fuera' }}</p>
  <p class="next-rival">{{ next_rival }}</p>
  <p><a class="button" href="equipos/{{ next_rival_slug }}.html">Ver el informe del rival →</a></p>
</section>
{% endif %}

<section>
  <h2>Partidos</h2>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>J</th><th>Fecha</th><th>Partido</th><th>Ritmo</th><th>ORtg</th><th>DRtg</th><th>Neto</th><th>Datos</th></tr></thead>
      <tbody>
      {% for g in games %}
        <tr>
          <td>{{ g.match.round }}</td>
          <td>{{ g.date }}</td>
          <td class="left"><span class="badge {{ 'win' if g.won else 'loss' }}">{{ 'V' if g.won else 'D' }}</span> <a href="partidos/{{ g.match.id }}.html">{{ g.title }}</a></td>
          <td>{{ g.pace }}</td><td>{{ g.ortg }}</td><td>{{ g.drtg }}</td><td>{{ g.net }}</td>
          <td>{% if g.issues %}<span class="warn">{{ g.issues }} aviso{{ 's' if g.issues > 1 }}</span>{% else %}✓{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section>
  <h2>Equipo frente a sus rivales</h2>
  <p class="hint">Medias por partido y porcentajes de tiro. "Rivales" es lo que han hecho los rivales contra {{ team_name }}.</p>
  <div class="table-wrap">{{ team | safe }}</div>
  <h3>Ritmo, eficiencia y Four Factors</h3>
  <p class="hint">En la columna de rivales: lo que permite la defensa.</p>
  <div class="table-wrap">{{ advanced | safe }}</div>
</section>

<section>
  <h2>Jugadores</h2>
  <div class="table-wrap">{{ players | safe }}</div>
</section>

<section>
  <h2>Mapa de tiros</h2>
  <div class="chart">{{ shots | safe }}</div>
  <h3>Por zonas</h3>
  <div class="table-wrap">{{ zones | safe }}</div>
  <h3>Por zonas, rivales</h3>
  <div class="table-wrap">{{ zones_rivals | safe }}</div>
</section>

<section>
  <h2>+/- y on/off</h2>
  <p class="hint">Neto = diferencia de puntos por 100 posesiones. "En banquillo" es el neto del equipo mientras el jugador no está en pista. Minutos según el reloj del jugada a jugada.</p>
  <div class="table-wrap">{{ on_off | safe }}</div>
</section>

<section>
  <h2>Quintetos</h2>
  <p class="hint">Los 10 con más minutos, por dorsales.</p>
  <div class="table-wrap">{{ lineups | safe }}</div>
  {% if lineups_incomplete %}<p class="note">{{ lineups_incomplete }} minutos sin 5 jugadores en pista (cambio mal anotado) no cuentan.</p>{% endif %}
  <p class="legend">{% for n, p in legend %}<span><b>{{ n }}</b> {{ p }}</span>{% endfor %}</p>
</section>

<section id="liga">
  <h2>Liga</h2>
  <p class="hint">Los {{ league_rows | length }} equipos con {{ n_league_games }} partidos jugados. Pulsa en un equipo para ver su informe de scouting.</p>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Equipo</th>{% for c in league_columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for row in league_rows %}
        <tr class="{{ 'own' if row.own }}{{ ' next' if row.next }}">
          <th><a href="equipos/{{ row.slug }}.html">{{ row.name }}</a>{% if row.next %} <span class="tag">próximo rival</span>{% endif %}</th>
          {% for v in row['values'] %}<td>{{ v }}</td>{% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

{% include "glossary.html.j2" %}
{% endblock %}

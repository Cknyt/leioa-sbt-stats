<section class="glossary">
  <details>
    <summary>Glosario y fórmulas</summary>
    <p class="hint">También puedes tocar el botón <span class="info-sample">?</span> que hay junto a cada término.</p>
    <dl>
    {% for terms, text in glossary %}
      <dt>{{ terms | join(", ") }}</dt><dd>{{ text }}</dd>
    {% endfor %}
      <dt>/PJ, /40</dt><dd>Media por partido jugado y por cada 40 minutos en pista.</dd>
    </dl>
  </details>
</section>
<script type="application/json" id="glossary-data">{{ glossary_json | safe }}</script>
<script src="{{ root }}glossary.js"></script>
